/**
 * ----------------------------------------------
 * Prisma Schema - 課程邀請模型
 * 2026-03-23 (Updated: 2026-03-30)
 * prisma/schema/course-invite.prisma
 * ----------------------------------------------
 */

// ==========================================
// 報名狀態枚舉
// ==========================================
enum EnrollmentStatus {
  pending // 待審核
  approved // 已核准
}

// ==========================================
// 書籍選擇枚舉
// ==========================================
enum MaterialChoice {
  none // 無須購買
  traditional // 繁體教材
  simplified // 簡體教材
}

// ==========================================
// 課程邀請主體
// ==========================================
model CourseInvite {
  id Int @id @default(autoincrement())

  title           String // 課程名稱（可自訂，預設為「{講師} 的 {課程}」）
  courseCatalogId Int // 對應課程目錄
  courseCatalog   CourseCatalog @relation(fields: [courseCatalogId], references: [id])
  maxCount        Int // 預計人數

  expiredAt  DateTime? // 邀請截止日期（選填）
  courseDate String? // 預計開課日期（YYYY/MM/DD 字串，選填）
  notes      String? // 內部備註（選填）

  // 公開媒合（布告欄招募）
  isPublicMatch Boolean @default(false) // 是否公開媒合（預設不公開）
  matchNote     String? // 公開招募備註（選填）

  // 教材訂單（一門課可有多筆；獨立訂單 courseInviteId 為 null 不在此清單）
  orders CourseOrder[]

  // 建立者
  createdById String @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  // 取消課程
  cancelledAt  DateTime? // 取消時間（有值即代表已取消）
  cancelReason String? // 取消原因文字

  // 課程進行中
  startedAt DateTime? // 開始授課時間（有值即代表進行中）

  // 教材申請完成標記（有值即不需再申請教材，開課門檻豁免教材需求條件）
  materialFinalizedAt DateTime?

  // 結業
  completedAt DateTime? // 結業時間（有值即代表已結業）

  // 結業時老師對整班的整體回饋（皆選填）
  gradRating    Int? // 本次學員整體學習狀況五星評分（1–5）
  gradTestimony String? // 見證（文字）

  enrollments InviteEnrollment[]

  // 課程 FAQ 留言關聯
  messages CourseMessage[]

  // 學習歷程回饋補建結果關聯
  feedbackResults LearningRecordFeedback[]

  // 管理操作紀錄關聯
  adminLogs AdminActionLog[]

  @@map("course_invites")
}

// ==========================================
// 學員報名記錄
// ==========================================
model InviteEnrollment {
  id       Int    @id @default(autoincrement())
  inviteId Int
  userId   String @db.Uuid

  invite CourseInvite @relation(fields: [inviteId], references: [id])
  user   User         @relation(fields: [userId], references: [id])

  status           EnrollmentStatus @default(pending) // 申請狀態
  materialChoice   MaterialChoice   @default(none) // 書籍選擇
  materialBookName String? // 書本名字（申購時填，預設中文→英文→匿名）

  // 教材逐本項目指派（此報名之書被指派至哪些寄送地址）
  shipmentItems MaterialShipmentItem[]

  joinedAt          DateTime  @default(now())
  graduatedAt       DateTime? // 結業時間（有值即代表通過結業）
  nonGraduateReason String? // 未結業原因（insufficient_time / other）

  // 講師資格回饋（由該課程建立者對已結業學員填寫；逐書語意依 invite.courseCatalogId）
  teacherRecommended  Boolean? // null=未填、true=推薦、false=不推薦
  teacherFeedbackNote String? // 選填備註
  teacherFeedbackAt   DateTime? // 填寫/最後更新時間（亦作「已填」判斷依據）

  // 後台對推薦的「暫不接受」決策（「已成為講師」則由是否具對應書籍講師身分推導，不落此欄）
  recommendDeferredAt   DateTime? // 暫不接受時間（有值即代表暫不接受）
  recommendDeferredById String?   @db.Uuid // 操作管理者
  recommendDeferredBy   User?     @relation("RecommendDeferredBy", fields: [recommendDeferredById], references: [id])
  recommendDeferralNote String? // 暫不接受備註

  @@unique([inviteId, userId])
  @@map("invite_enrollments")
}
