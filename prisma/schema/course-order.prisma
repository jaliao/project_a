/**
 * ----------------------------------------------
 * Prisma Schema - 課程訂購模型
 * 2026-03-23 (Updated: 2026-03-31)
 * prisma/schema/course-order.prisma
 * ----------------------------------------------
 */

// ==========================================
// 教材版本枚舉
// ==========================================
enum MaterialVersion {
  traditional // 繁體版
  simplified // 簡體版
  both // 繁體＋簡體
}

// ==========================================
// 購買性質枚舉
// ==========================================
enum PurchaseType {
  selfOnly // 種子教師自用
  selfAndProxy // 自用＋代購
  proxyOnly // 只幫學員代購
}

// ==========================================
// 取貨方式枚舉
// ==========================================
enum DeliveryMethod {
  sevenEleven // 7-11 取貨
  familyMart // 全家取貨
  delivery // 郵寄/宅配
}

// ==========================================
// 寄送模式枚舉（單一地址 / 多個地址）
// ==========================================
enum ShipMode {
  single // 單一地址（沿用 CourseOrder 自身寄件欄位）
  multiple // 多個地址（改用 MaterialShipment 批次）
}

// ==========================================
// 課程訂購模型
// ==========================================
model CourseOrder {
  id Int @id @default(autoincrement())

  // 購買人基本資料
  buyerNameZh String // 購買人中文姓名
  buyerNameEn String // 購買人英文姓名
  teacherName String // 購買人的教師姓名
  churchOrg   String // 所屬教會/單位
  email       String
  phone       String

  // 寄送模式（single：單一地址；multiple：多地址批次）
  shipMode  ShipMode           @default(single)
  shipments MaterialShipment[]

  // 教材與購買選項
  materialVersion MaterialVersion
  purchaseType    PurchaseType
  studentNames    String? // 幫學員代購（含代購時必填）

  // 數量
  quantity     Int // 1–8；選「其他」時為 0
  quantityNote String? // 自填數量說明

  // 本筆申請的書籍本數（單一地址自動帶當下尚未申請的剩餘；多地址為各批次加總）
  traditionalQty Int @default(0) // 繁體本數
  simplifiedQty  Int @default(0) // 簡體本數

  // 其他
  courseDate      String // 預計開課日期（可填「無」）
  taxId           String? // 統一編號（選填）
  deliveryMethod  DeliveryMethod
  deliveryAddress String? // 收件地址（全家、郵寄用）
  storeId         String? // 7-11 門市店號（透過門市選擇器取得）
  storeName       String? // 7-11 門市名稱（透過門市選擇器取得）

  // 單一地址收件人（預設帶入申請講師，可修改）
  recipientName  String? // 收件人姓名
  recipientPhone String? // 收件人連絡電話

  // 提交者（選填關聯）
  submittedById String? @db.Uuid
  submittedBy   User?   @relation(fields: [submittedById], references: [id])

  createdAt DateTime @default(now())

  // 金流繳費追蹤（批價 → 付款 → 確認收款）
  quotedAmount       Int? // 批價金額（新台幣元，整數）
  remittanceAccount  String? // 批價時的匯款帳號快照
  quotedAt           DateTime? // 管理者批價時間
  paymentLast5       String? // 老師回填的匯款後五碼
  paymentReportedAt  DateTime? // 老師回填時間
  paymentConfirmedAt DateTime? // 管理者確認收款時間

  // 教材寄送追蹤
  shippedAt  DateTime? // 管理者確認寄送時間
  receivedAt DateTime? // 講師確認收件時間

  // 課程邀請關聯（一門課對多筆訂單；獨立訂單為 null）
  courseInviteId Int?
  courseInvite   CourseInvite? @relation(fields: [courseInviteId], references: [id])

  @@index([courseInviteId])
  @@map("course_orders")
}

// ==========================================
// 教材寄送批次（多地址模式：一張訂單對多筆寄送）
// ==========================================
model MaterialShipment {
  id Int @id @default(autoincrement())

  courseOrderId Int
  courseOrder   CourseOrder @relation(fields: [courseOrderId], references: [id], onDelete: Cascade)

  // 收件人（每個地址各自填寫）
  recipientName  String? // 收件人姓名
  recipientPhone String? // 收件人連絡電話

  // 寄件資訊（沿用 CourseOrder 欄位語意）
  deliveryMethod  DeliveryMethod
  deliveryAddress String? // 宅配地址
  storeId         String? // 超商門市店號
  storeName       String? // 超商門市名稱

  // 各版本本數
  traditionalQty Int @default(0) // 繁體本數
  simplifiedQty  Int @default(0) // 簡體本數

  shippedAt DateTime? // 此批次寄送時間（有值即已寄送）
  createdAt DateTime  @default(now())

  @@index([courseOrderId])
  @@map("material_shipments")
}
