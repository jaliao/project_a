# ----------------------------------------------
# Dockerfile.prod
# ----------------------------------------------

# 1) Base Image
# slim（Debian/glibc）而非 alpine：Next 16 Turbopack 需要原生 SWC binding，
# alpine(musl) 下 npm 誤裝 gnu 版且 Turbopack 不支援 WASM fallback（build 必炸）；與 Dockerfile.dev 一致
FROM node:22-slim AS base
WORKDIR /app

# Prisma 需要的 runtime 依賴
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ========================================================
# 2) 依賴安裝階段
# ========================================================
FROM base AS deps
COPY package.json package-lock.json .npmrc ./
# npm ci 預設會安裝 devDependencies（builder 需要 prisma CLI）
RUN npm ci

# ========================================================
# 3) 建置階段 (Builder)
# ========================================================
FROM base AS builder
WORKDIR /app

# 注意：Next build / prisma generate 通常都需要 devDependencies
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Prisma 7 + prisma.config.ts + schema 多檔：generate 不需要真的連 DB
# 但 schema/datasource.url 會讀 env("DATABASE_URL")，所以給一個 build-time 值即可
ARG DATABASE_URL="postgresql://build:build@localhost:5432/build_db"
ENV DATABASE_URL=$DATABASE_URL

# NEXT_PUBLIC_* 會在 `next build` 當下就內嵌進前端 JS bundle，屬 build-time 值，
# 不能只靠 runner 階段的 env_file（那是 runtime，對已編譯好的前端程式碼無效）
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY
ENV NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY

# 產生 Prisma Client（會讀取 prisma.config.ts 內的 schema: 'prisma/schema'）
RUN npx prisma generate

# Next.js build（standalone）
RUN npm run build

# ========================================================
# 4) 執行階段 (Runner)
# ========================================================
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# 建立系統使用者（Debian 語法）
RUN groupadd --system --gid 1001 nodejs && \
    useradd  --system --uid 1001 --gid nodejs nextjs

# 時區（可選）
RUN apt-get update && apt-get install -y --no-install-recommends tzdata \
    && ln -sf /usr/share/zoneinfo/Asia/Taipei /etc/localtime \
    && rm -rf /var/lib/apt/lists/*

# Next standalone output
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# public/（含 PWA sw.js 等靜態檔）standalone 模式不會自動打包，需另外複製
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# 保守補齊 Prisma engine（避免 standalone 漏帶 .prisma）
# COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
